name: Create Fingerprint Gist & Notify Discord

on:
  workflow_dispatch:
    inputs:
      fingerprint:
        description: 'Fingerprint JSON string'
        required: true

jobs:
  process:
    runs-on: ubuntu-latest
    steps:
      - name: Create secret Gist
        id: create_gist
        env:
          GIST_TOKEN: ${{ secrets.GIST_TOKEN }}
        run: |
          RESPONSE=$(curl -s -X POST https://api.github.com/gists \
            -H "Authorization: token $GIST_TOKEN" \
            -H "Accept: application/vnd.github.v3+json" \
            -d @- <<EOF
          {
            "description": "Browser fingerprint",
            "public": false,
            "files": {
              "fingerprint.json": {
                "content": $(echo '${{ github.event.inputs.fingerprint }}' | jq -Rs .)
              }
            }
          }
          EOF
          )
          RAW_URL=$(echo "$RESPONSE" | jq -r '.files["fingerprint.json"].raw_url')
          echo "raw_url=$RAW_URL" >> $GITHUB_OUTPUT

      - name: Send to Discord
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
        run: |
          curl -s -X POST "$DISCORD_WEBHOOK" \
            -H "Content-Type: application/json" \
            -d "$(jq -n --arg content "📄 **Fingerprint captured**\n🔗 [Tải fingerprint.json](${{ steps.create_gist.outputs.raw_url }})" '{content: $content}')"
